# Google Gemini API Key (Wajib untuk analisis AI & Multimodal Vision)
GEMINI_API_KEY=your_gemini_api_key_here

# Daftar Master Kode Lisensi Pro Kustom (Opsional, pisahkan dengan koma)
# Default bawaan: LMPRO-2026-BERES, LMPRO-SULTAN-99, KKN-DESA-2026, LMPRO-REGULER-2026
PRO_LICENSE_KEYS=LMPRO-2026-BERES,LMPRO-SULTAN-99,KKN-DESA-2026,KAMPUS-MERDEKA-VIP

# URL Gateway Pembayaran QRIS / WhatsApp Konfirmasi Checkout (Opsional)
# NEXT_PUBLIC_PAYMENT_URL=https://app.midtrans.com/payment-links/logmagang-pro
