rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             data.email is string &&
             data.email.size() > 0 &&
             data.email.size() <= 150 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('nim' in data) || (data.nim is string && data.nim.size() <= 50)) &&
             (!('campus' in data) || (data.campus is string && data.campus.size() <= 150)) &&
             (!('prodi' in data) || (data.prodi is string && data.prodi.size() <= 150)) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('lastLoginAt' in data) || data.lastLoginAt is string);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().uid == userId;
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
